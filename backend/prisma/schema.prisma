generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  ADMIN
}

enum AppointmentStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum WaitlistStatus {
  WAITING
  OFFERED
  ACCEPTED
  EXPIRED
  REJECTED
  CANCELLED_BY_PATIENT
}

enum OfferStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REJECTED
}

model User {
  id              String          @id @default(uuid())
  email           String          @unique
  passwordHash    String
  name            String
  phone           String?
  role            Role            @default(PATIENT)
  createdAt       DateTime        @default(now())

  appointments    Appointment[]
  waitlistEntries WaitlistEntry[]
}

model WorkingHours {
  id          String @id @default(uuid())
  weekday     Int
  startMinute Int
  endMinute   Int

  @@index([weekday])
}

model ScheduleException {
  id          String   @id @default(uuid())
  date        DateTime
  isClosed    Boolean  @default(true)
  startMinute Int?
  endMinute   Int?

  @@unique([date])
}

model ScheduleConfig {
  id                  String @id @default("singleton")
  slotDurationMinutes Int    @default(30)
  bufferMinutes       Int    @default(0)
  minNoticeHours      Int    @default(2)
  maxAdvanceDays      Int    @default(30)
}

model Appointment {
  id          String            @id @default(uuid())
  patientId   String
  patient     User              @relation(fields: [patientId], references: [id])
  startsAt    DateTime
  endsAt      DateTime
  status      AppointmentStatus @default(SCHEDULED)
  createdAt   DateTime          @default(now())
  cancelledAt DateTime?

  waitlistWatchers WaitlistEntry[]

  @@index([status, startsAt])
}

model WaitlistEntry {
  id        String         @id @default(uuid())
  patientId String
  patient   User           @relation(fields: [patientId], references: [id])
  status    WaitlistStatus @default(WAITING)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  watchedAppointmentId String
  watchedAppointment   Appointment @relation(fields: [watchedAppointmentId], references: [id])

  offer Offer?

  @@index([status, createdAt])
  @@index([watchedAppointmentId, status])
}

model Offer {
  id              String        @id @default(uuid())
  waitlistEntryId String        @unique
  waitlistEntry   WaitlistEntry @relation(fields: [waitlistEntryId], references: [id])
  startsAt        DateTime
  endsAt          DateTime
  expiresAt       DateTime
  status          OfferStatus   @default(PENDING)
  createdAt       DateTime      @default(now())
}